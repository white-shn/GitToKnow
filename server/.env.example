# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# GitHub token (optional, avoids the 60 requests/hour anonymous rate limit)
GITHUB_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma 4 model ids on the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-001

# true = repo endpoints return mock data (client can be built without the real pipeline)
USE_MOCK_DATA=true
