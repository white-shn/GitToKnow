# Comma-separated list of origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex of extra allowed origins (used on Render)
CORS_ORIGIN_REGEX=

# GitHub token (optional, avoids the 60 requests/hour anonymous rate limit)
GITHUB_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemma 4 model ids on the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
EMBEDDING_MODEL=gemini-embedding-001

# Optional fallback if Gemma 4 fails or runs out of quota (any OpenAI-compatible chat API).
# Defaults to xAI Grok (a hosted, closed model); see docs.x.ai for model names. Leave the key empty to disable.
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.x.ai/v1
FALLBACK_MODEL=grok-4

# true = repo endpoints return fake demo data (UI development without GitHub or Gemini)
USE_MOCK_DATA=false
